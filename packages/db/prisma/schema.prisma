generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admins {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String
  phone        String
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
}

model AdminOtps {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  adminId   String    @map("admin_id") @db.ObjectId
  otp       String
  purpose   String?
  createdAt DateTime  @map("created_at")
  updatedAt DateTime  @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model Organizations {
  id                  String                     @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  domain              String                     @unique
  GSTNumber           String?                    @map("gst_number")
  email               String?
  contactPersonName   String?                    @map("contact_person_name")
  contactPersonNumber String?                    @map("contact_person_number")
  note                String?
  industry            String?
  size                Int?
  address             Json?
  createdAt           DateTime                   @map("created_at")
  updatedAt           DateTime                   @map("updated_at")
  deletedAt           DateTime?                  @map("deleted_at")
  attendance          Attendance[]
  departments         OrganizationDepartments[]
  designations        OrganizationDesignations[]
  employees           OrganizationEmployees[]
  categories          EmployeeCategories[]
  onboardingFlows     EmployeeOnboardingFlows[]  @relation("OrganizationOnboardings")
  shifts              Shifts[]
  holidays            Holidays[]
  leaveTypes          LeaveTypes[]
  geoFences           GeoFences[]
  attendancePolicies  AttendancePolicies[]
  leavePolicies       LeavePolicies[]
  shiftPolicies       ShiftPolicies[]
  holidayPolicies     HolidayPolicies[]
  networkpolicies     NetworkPolicies[]
  approvalFlows       ApprovalFlows[]
  approvalLogs        ApprovalLogs[]
  leaveRequests       LeaveRequests[]
  workrequests        WorkdayRequests[]
}

model OrganizationDepartments {
  id                      String                     @id @default(auto()) @map("_id") @db.ObjectId
  organizationId          String                     @map("organization_id") @db.ObjectId
  name                    String
  code                    String?
  departmentHeadId        String?                    @map("department_head_id") @db.ObjectId
  departmentHeadStratDate DateTime?                  @map("department_head_start_date")
  description             String?
  note                    String?
  organization            Organizations              @relation(fields: [organizationId], references: [id])
  createdAt               DateTime                   @map("created_at")
  updatedAt               DateTime                   @map("updated_at")
  deletedAt               DateTime?                  @map("deleted_at")
  DepartmentDesignation   OrganizationDesignations[]
  DepartmentEmployees     EmployeeDepartments[]
}

model OrganizationDesignations {
  id             String                   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                   @map("organization_id") @db.ObjectId
  departmentId   String?                  @map("department_id") @db.ObjectId
  name           String
  level          String?
  description    String?
  organization   Organizations            @relation(fields: [organizationId], references: [id])
  department     OrganizationDepartments? @relation(fields: [departmentId], references: [id])
  employees      OrganizationEmployees[]
  createdAt      DateTime                 @map("created_at")
  updatedAt      DateTime                 @map("updated_at")
  deletedAt      DateTime?                @map("deleted_at")
}

model EmployeeCategories {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String  @map("organization_id") @db.ObjectId
  name               String
  code               String?
  description        String?
  idPrefix           String? @map("id_prefix")
  isPermanent        Boolean @map("is_permanent")
  benefitsApplicable Boolean @map("benefits_applciable")
  isActive           Boolean @default(true) @map("is_active")
  trainingRequired   Boolean @default(true) @map("training_required")
  trainingMonths     Int     @default(6) @map("training_months")
  probationRequired  Boolean @default(true) @map("probation_required")
  probationMonths    Int     @default(3) @map("probation_months")
  noticeRequired     Boolean @default(true) @map("notice_required")
  noticeMonths       Int     @default(2) @map("notice_months")

  organization Organizations           @relation(fields: [organizationId], references: [id])
  employees    OrganizationEmployees[]

  createdAt DateTime  @map("created_at")
  updatedAt DateTime  @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model EmployeeOnboardingFlows {
  id             String                    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                    @map("organization_id") @db.ObjectId
  organization   Organizations             @relation("OrganizationOnboardings", fields: [organizationId], references: [id])
  name           String
  description    String?
  steps          Int?
  estimatedDays  Int?                      @map("estimated_days")
  stepsList      EmployeeOnboardingSteps[]
  progress       OnboardingProgress[]      @relation("FlowProgress")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  deletedAt      DateTime?                 @map("deleted_at")
}

model EmployeeOnboardingSteps {
  id           String                   @id @default(auto()) @map("_id") @db.ObjectId
  onboardingId String                   @map("onboarding_id") @db.ObjectId
  onboarding   EmployeeOnboardingFlows  @relation(fields: [onboardingId], references: [id])
  name         String
  isActive     Boolean                  @default(true) @map("is_active")
  features     OnboardingStepFeatures[]
  progress     OnboardingProgress[]     @relation("StepProgress")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  deletedAt    DateTime?                @map("deleted_at")
}

model OnboardingStepFeatures {
  id          String                  @id @default(auto()) @map("_id") @db.ObjectId
  stepId      String                  @map("step_id") @db.ObjectId
  featureName String                  @map("feature_name")
  featureType String                  @map("feature_type")
  hasOptions  Boolean                 @default(false) @map("has_options")
  options     Json?
  step        EmployeeOnboardingSteps @relation(fields: [stepId], references: [id])
  progress    OnboardingProgress[]    @relation("FeatureProgress")
}

model OnboardingProgress {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  employeeId       String                  @map("employee_id") @db.ObjectId
  flowId           String                  @map("flow_id") @db.ObjectId
  stepId           String                  @map("step_id") @db.ObjectId
  stepFeatureId    String                  @map("step_feature_id") @db.ObjectId
  stepFeatureValue String?                 @map("step_feature_value")
  employee         OrganizationEmployees   @relation("EmployeeOnboardingProgress", fields: [employeeId], references: [id])
  flow             EmployeeOnboardingFlows @relation("FlowProgress", fields: [flowId], references: [id])
  step             EmployeeOnboardingSteps @relation("StepProgress", fields: [stepId], references: [id])
  feature          OnboardingStepFeatures  @relation("FeatureProgress", fields: [stepFeatureId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model OrganizationEmployees {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String  @map("organization_id") @db.ObjectId
  categoryId     String  @map("category_id") @db.ObjectId
  designationId  String? @map("designation_id") @db.ObjectId

  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  fullName    String   @map("full_name")
  email       String?
  phone       String
  altPhone    String?  @map("alt_phone")
  gender      Gender
  dateOfBirth DateTime @db.Date

  organization            Organizations              @relation(fields: [organizationId], references: [id])
  category                EmployeeCategories         @relation(fields: [categoryId], references: [id])
  designation             OrganizationDesignations?  @relation(fields: [designationId], references: [id])
  attendance              Attendance[]
  departmentAssignments   EmployeeDepartments[]
  onboardingProgress      OnboardingProgress[]       @relation("EmployeeOnboardingProgress")
  EmployeeShiftAssignment EmployeeShiftAssignment[]
  regularisations         AttendanceRegularisation[]
  leaveRequests           LeaveRequests[]
  workrequests            WorkdayRequests[]
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  deletedAt               DateTime?                  @map("deleted_at")
}

model EmployeeDepartments {
  id           String                   @id @default(auto()) @map("_id") @db.ObjectId
  departmentId String                   @map("department_id") @db.ObjectId
  department   OrganizationDepartments? @relation(fields: [departmentId], references: [id])
  employeeId   String                   @map("employee_id") @db.ObjectId
  employee     OrganizationEmployees    @relation(fields: [employeeId], references: [id])
  startDate    DateTime                 @map("start_date")
  endDate      DateTime?                @map("end_date")
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  HOLIDAY
}

enum LogType {
  CHECK_IN
  CHECK_OUT
  ADJUSTMENT
}

enum AttendanceMode {
  OFFICE
  WORK_FROM_HOME
  ON_DUTY
  PARTIAL_DAY
}

model Attendance {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String    @map("organization_id") @db.ObjectId
  employeeId         String    @map("employee_id") @db.ObjectId
  date               DateTime  @db.Date
  checkIn            DateTime? @map("check_in")
  checkOut           DateTime? @map("check_out")
  location           Json?
  grossHours         Float?    @map("gross_hours")
  effectiveHours     Float?    @map("effective_hours")
  lateArrivalMinutes Int?      @map("late_arrival_minutes")

  status    AttendanceStatus @default(PENDING)
  isHoliday Boolean          @default(false) @map("is_holiday")
  requests  Json?
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  mode      AttendanceMode?  @default(OFFICE)

  // Relations
  organization    Organizations              @relation(fields: [organizationId], references: [id])
  employee        OrganizationEmployees      @relation(fields: [employeeId], references: [id])
  logs            AttendanceLogs[]
  regularisations AttendanceRegularisation[]
  workrequests    WorkdayRequests[]
}

model AttendanceLogs {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  attendanceId String  @map("attendance_id") @db.ObjectId
  type         LogType @map("type")
  ipAddress    String?
  geoLocation  Json?

  source    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id])
}

model Shifts {
  id               String                    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String                    @db.ObjectId
  name             String
  startTime        DateTime
  endTime          DateTime
  breakMinutes     Int?
  applicableDays   Json?                     @map("applicable_days")
  weeklyOff        String[]
  organization     Organizations             @relation(fields: [organizationId], references: [id])
  shiftAssignments EmployeeShiftAssignment[]
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  deletedAt        DateTime?                 @map("deleted_at")
}

enum RegularisationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceRegularisation {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  attendanceId String                 @db.ObjectId
  employeeId   String                 @db.ObjectId
  reason       String
  status       RegularisationStatus   @default(PENDING)
  requestedAt  DateTime               @default(now())
  approvedAt   DateTime?
  approvedBy   String?                @map("approved_by") @db.ObjectId
  remarks      String?
  attendance   Attendance?            @relation(fields: [attendanceId], references: [id])
  employee     OrganizationEmployees? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  deletedAt    DateTime?              @map("deleted_at")
}

model ApprovalFlows {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String        @map("organization_id") @db.ObjectId
  entityType      String // e.g. "LEAVE", "REGULARISATION", "ON_DUTY", "WORK_FROM_HOME"
  level           Int // e.g. 1 = Manager, 2 = HR
  role            String // e.g. "MANAGER", "HR", "LEAD"
  approverId      String?       @map("approver_id") @db.ObjectId // optional direct approver
  nextLevelId     String?       @map("next_level_id") @db.ObjectId
  autoApproveDays Int?          @default(3) // auto approve after 3 days
  escalationRole  String? // optional escalation role (e.g. "HR")
  isActive        Boolean       @default(true)
  organization    Organizations @relation(fields: [organizationId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
}

model ApprovalLogs {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @map("organization_id") @db.ObjectId
  entityId       String   @map("entity_id") @db.ObjectId // ID of leave/regularisation/on-duty
  entityType     String // e.g. "LEAVE", "REGULARISATION", "WORK_FROM_HOME"
  level          Int // approval level
  approverId     String?  @map("approver_id") @db.ObjectId
  action         String // "APPROVED" | "REJECTED" | "SKIPPED" | "ESCALATED"
  remarks        String?
  approvedAt     DateTime @default(now()) @map("approved_at")

  organization Organizations @relation(fields: [organizationId], references: [id])
}

model Holidays {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @db.ObjectId
  date           DateTime
  name           String
  region         String?
  organization   Organizations @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
}

model EmployeeShiftAssignment {
  id         String                @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String                @map("employee_id") @db.ObjectId
  shiftId    String                @map("shift_id") @db.ObjectId
  validFrom  DateTime
  validTo    DateTime?
  employee   OrganizationEmployees @relation(fields: [employeeId], references: [id])
  shift      Shifts                @relation(fields: [shiftId], references: [id])
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  deletedAt  DateTime?             @map("deleted_at")
}

model GeoFences {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String  @map("organization_id") @db.ObjectId
  name           String // e.g., "Head Office"
  latitude       Float // center lat
  longitude      Float // center lng
  radiusMeters   Int // allowed radius (meters)
  isActive       Boolean @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveTypes {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String  @db.ObjectId
  name           String // "Casual Leave"
  code           String // "CL"
  paid           Boolean @default(true)
  maxPerYear     Int?    @map("max_per_year")

  organization  Organizations   @relation(fields: [organizationId], references: [id])
  leaveRequests LeaveRequests[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model LeaveRequests {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  employeeId     String                @map("employee_id") @db.ObjectId
  organizationId String                @map("organization_id") @db.ObjectId
  leaveTypeId    String                @map("leave_type_id") @db.ObjectId
  startDate      DateTime              @map("start_date")
  endDate        DateTime              @map("end_date")
  reason         String?
  status         LeaveStatus           @default(PENDING)
  approvedAt     DateTime?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")
  organization   Organizations         @relation(fields: [organizationId], references: [id])
  employee       OrganizationEmployees @relation(fields: [employeeId], references: [id])
  leaveType      LeaveTypes            @relation(fields: [leaveTypeId], references: [id])
}

model AttendancePolicies {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String  @map("organization_id") @db.ObjectId
  name               String // "Default Attendance Policy"
  graceMinutes       Int?    @default(10) // Late grace period
  halfDayMinutes     Int?    @default(240) // 4 hours
  fullDayMinutes     Int?    @default(480) // 8 hours
  allowGeoCheckIn    Boolean @default(true)
  allowOutsideGeo    Boolean @default(false)
  autoMarkAbsent     Boolean @default(true)
  checkInBufferMin   Int?    @default(15)
  checkOutBufferMin  Int?    @default(15)
  roundingStrategy   String? // e.g. "nearest_15_min"
  overtimeAllowed    Boolean @default(false)
  minOvertimeMinutes Int?    @default(30)
  isActive           Boolean @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

model LeavePolicies {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId    String  @map("organization_id") @db.ObjectId
  name              String // "Default Leave Policy"
  carryForward      Boolean @default(true)
  maxCarryForward   Int?    @default(12)
  encashmentAllowed Boolean @default(false)
  sandwichRule      Boolean @default(true)
  accrualFrequency  String? @default("monthly") // daily / monthly / yearly
  accrueAfterDays   Int?    @default(30)
  isActive          Boolean @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

model ShiftPolicies {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String  @map("organization_id") @db.ObjectId
  name             String // "Rotational Shift Policy"
  autoAssign       Boolean @default(false)
  graceBeforeStart Int?    @default(10) // minutes early allowed
  graceAfterEnd    Int?    @default(10) // minutes late allowed
  nightShiftStart  String? // "22:00"
  nightShiftEnd    String? // "06:00"
  rotational       Boolean @default(false)
  rotationPeriod   Int?    @default(7)
  isActive         Boolean @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

model HolidayPolicies {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @map("organization_id") @db.ObjectId
  name           String // "India North Region Policy"
  region         String
  applicableTo   String[] // list of branch codes or dept IDs
  isActive       Boolean  @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

model NetworkPolicies {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @map("organization_id") @db.ObjectId
  name           String // e.g., "Office WiFi Only"
  enforceOn      String        @default("ATTENDANCE") // "LOGIN" | "ATTENDANCE" | "BOTH"
  allowedIPs     String[] // array of exact IPs (e.g., ["203.0.113.5", "203.0.113.6"])
  isActive       Boolean       @default(true)
  organization   Organizations @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
}

enum WorkdayType {
  WORK_FROM_HOME
  ON_DUTY
  PARTIAL_DAY
}

enum WorkdayStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model WorkdayRequests {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                @map("organization_id") @db.ObjectId
  employeeId     String                @map("employee_id") @db.ObjectId
  type           WorkdayType
  startDate      DateTime              @map("start_date")
  endDate        DateTime?             @map("end_date")
  startTime      DateTime?             @map("start_time")
  endTime        DateTime?             @map("end_time")
  reason         String?
  status         WorkdayStatus         @default(PENDING)
  approvalLevel  Int?                  @default(1)
  approvedAt     DateTime?
  approvedBy     String?               @map("approved_by") @db.ObjectId
  remarks        String?
  attendanceId   String?               @map("attendance_id") @db.ObjectId
  organization   Organizations         @relation(fields: [organizationId], references: [id])
  employee       OrganizationEmployees @relation(fields: [employeeId], references: [id])
  attendance     Attendance?           @relation(fields: [attendanceId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}
