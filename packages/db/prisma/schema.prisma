generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admins {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String
  phone        String
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
}

model Otps {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  adminId        String?   @map("admin_id") @db.ObjectId
  employeeId     String?   @map("employee_id") @db.ObjectId
  organizationId String?   @map("organization_id") @db.ObjectId
  otp            String
  purpose        String?
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
}

model Organizations {
  id                  String                     @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  domain              String                     @unique
  GSTNumber           String?                    @map("gst_number")
  email               String?
  contactPersonName   String?                    @map("contact_person_name")
  contactPersonNumber String?                    @map("contact_person_number")
  accessToken         String?                    @map("access_token")
  refreshToken        String?                    @map("refresh_token")
  note                String?
  industry            String?
  size                Int?
  activeEmployee      Int?                       @default(0)
  totalEmployee       Int?                       @default(0)
  address             Json?
  createdAt           DateTime                   @map("created_at")
  updatedAt           DateTime                   @map("updated_at")
  deletedAt           DateTime?                  @map("deleted_at")
  attendance          Attendance[]
  departments         OrganizationDepartments[]
  designations        OrganizationDesignations[]
  employees           OrganizationEmployees[]
  categories          EmployeeCategories[]
  onboardingFlows     EmployeeOnboardingFlows[]  @relation("OrganizationOnboardings")
  shifts              Shifts[]
  holidays            Holidays[]
  leaveTypes          LeaveTypes[]
  geoFences           GeoFences[]
  attendancePolicies  AttendancePolicies[]
  shiftPolicies       ShiftPolicies[]
  holidayPolicies     HolidayPolicies[]
  networkpolicies     NetworkPolicies[]
  approvalLogs        ApprovalLogs[]
  approvalInstances   ApprovalInstance[]
  approvers           ApprovalFlowApprovers[]
  leaveRequests       LeaveRequests[]
  workrequests        WorkdayRequests[]
  approvalflows       ApprovalFlows[]
  posts               Posts[]
  assetconditions     AssetCondition[]
  assetRequests       AssetRequest[]

  smsNotification      Boolean @default(false)
  emailNotification    Boolean @default(true)
  whatsappNotification Boolean @default(false)
  pushNotification     Boolean @default(true)

  maxEmployees              Int?                  @default(20) @map("max_employees")
  maxStorageInGB            Int?                  @default(10) @map("max_storage_in_gb")
  maxApiRatePerMin          Int?                  @default(1000) @map("max_api_rate_per_minute")
  maxPayrollRunsPerMonth    Int?                  @default(1) @map("max_payout_runs_per_month")
  maxLeavePolicies          Int?                  @default(5) @map("max_leave_policies")
  maxAdminAccounts          Int?                  @default(3) @map("max_admin_accounts")
  assetCategories           AssetCategories[]
  assetModels               AssetModels[]
  assets                    Assets[]
  assetAssignment           AssetAssignments[]
  attendanceReports         AttendanceReports[]
  salaryComponentDefinition ComponentDefinition[]
  salaryTemplates           SalaryTemplate[]
  organizationFinanc        OrgaizationFinance?
}

model OrgaizationFinance {
  id                             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId                 String        @unique @map("organization_id") @db.ObjectId
  organization                   Organizations @relation(fields: [organizationId], references: [id])
  enablePf                       Boolean?      @default(false) @map("enable_pf")
  enableEsi                      Boolean?      @default(false) @map("enable_esi")
  enablePtax                     Boolean?      @default(false) @map("enable_ptax")
  pfFormula                      String?       @map("pf_formula")
  pfRegistrationNumber           String?       @map("pf_registration_number")
  pfRegisteredOrganizationName   String?       @map("pf_registered_organization_name")
  esiFormula                     String?       @map("esi_formula")
  esiRegistrationNumber          String?       @map("esi_registration_number")
  esiRegisteredOrganizationName  String?       @map("esi_registered_organization_name")
  ptaxFormula                    String?       @map("ptax_formula")
  ptaxRegistrationNumber         String?       @map("ptax_registration_number")
  ptaxRegisteredOrganizationName String?       @map("ptax_registered_organization_name")
  createdAt                      DateTime      @map("created_at")
  updatedAt                      DateTime      @map("updated_at")
  deletedAt                      DateTime?     @map("deleted_at")
}

model OrganizationDepartments {
  id                      String                     @id @default(auto()) @map("_id") @db.ObjectId
  organizationId          String                     @map("organization_id") @db.ObjectId
  name                    String
  code                    String?
  departmentHeadId        String?                    @map("department_head_id") @db.ObjectId
  departmentHeadStartDate DateTime?                  @map("department_head_start_date")
  departmentHead          OrganizationEmployees?     @relation("DepartmentHead", fields: [departmentHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description             String?
  note                    String?
  organization            Organizations              @relation(fields: [organizationId], references: [id])
  createdAt               DateTime                   @map("created_at")
  updatedAt               DateTime                   @map("updated_at")
  deletedAt               DateTime?                  @map("deleted_at")
  DepartmentDesignation   OrganizationDesignations[]
  DepartmentEmployees     EmployeeDepartments[]
  organizationEmployees   OrganizationEmployees?     @relation(fields: [organizationEmployeesId], references: [id])
  organizationEmployeesId String?                    @db.ObjectId
  attendanceReports       AttendanceReports[]
}

model OrganizationDesignations {
  id                String                   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId    String                   @map("organization_id") @db.ObjectId
  departmentId      String?                  @map("department_id") @db.ObjectId
  name              String
  level             String?
  description       String?
  organization      Organizations            @relation(fields: [organizationId], references: [id])
  department        OrganizationDepartments? @relation(fields: [departmentId], references: [id])
  employees         OrganizationEmployees[]  @relation("DesignationEmployees")
  createdAt         DateTime                 @map("created_at")
  updatedAt         DateTime                 @map("updated_at")
  deletedAt         DateTime?                @map("deleted_at")
  attendanceReports AttendanceReports[]
}

model EmployeeCategories {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String  @map("organization_id") @db.ObjectId
  name               String
  code               String?
  description        String?
  idPrefix           String? @map("id_prefix")
  isPermanent        Boolean @map("is_permanent")
  benefitsApplicable Boolean @map("benefits_applciable")
  isActive           Boolean @default(true) @map("is_active")
  trainingRequired   Boolean @default(true) @map("training_required")
  trainingMonths     Int     @default(6) @map("training_months")
  probationRequired  Boolean @default(true) @map("probation_required")
  probationMonths    Int     @default(3) @map("probation_months")
  noticeRequired     Boolean @default(true) @map("notice_required")
  noticeMonths       Int     @default(2) @map("notice_months")

  organization Organizations           @relation(fields: [organizationId], references: [id])
  employees    OrganizationEmployees[]

  createdAt DateTime  @map("created_at")
  updatedAt DateTime  @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model EmployeeOnboardingFlows {
  id             String                    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                    @map("organization_id") @db.ObjectId
  organization   Organizations             @relation("OrganizationOnboardings", fields: [organizationId], references: [id])
  name           String
  description    String?
  steps          Int?
  estimatedDays  Int?                      @map("estimated_days")
  stepsList      EmployeeOnboardingSteps[]
  progress       OnboardingProgress[]      @relation("FlowProgress")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  deletedAt      DateTime?                 @map("deleted_at")
}

model EmployeeOnboardingSteps {
  id           String                   @id @default(auto()) @map("_id") @db.ObjectId
  onboardingId String                   @map("onboarding_id") @db.ObjectId
  onboarding   EmployeeOnboardingFlows  @relation(fields: [onboardingId], references: [id])
  name         String
  isActive     Boolean                  @default(true) @map("is_active")
  features     OnboardingStepFeatures[]
  progress     OnboardingProgress[]     @relation("StepProgress")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  deletedAt    DateTime?                @map("deleted_at")
}

model OnboardingStepFeatures {
  id          String                  @id @default(auto()) @map("_id") @db.ObjectId
  stepId      String                  @map("step_id") @db.ObjectId
  featureName String                  @map("feature_name")
  featureType String                  @map("feature_type")
  isRequired  Boolean?                @default(true) @map("is_required")
  hasOptions  Boolean                 @default(false) @map("has_options")
  options     Json?
  step        EmployeeOnboardingSteps @relation(fields: [stepId], references: [id])
  progress    OnboardingProgress[]    @relation("FeatureProgress")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  deletedAt   DateTime?               @map("deleted_at")
}

model OnboardingProgress {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  employeeId       String                  @map("employee_id") @db.ObjectId
  flowId           String                  @map("flow_id") @db.ObjectId
  stepId           String                  @map("step_id") @db.ObjectId
  stepFeatureId    String                  @map("step_feature_id") @db.ObjectId
  stepFeatureValue String?                 @map("step_feature_value")
  employee         OrganizationEmployees   @relation("EmployeeOnboardingProgress", fields: [employeeId], references: [id])
  flow             EmployeeOnboardingFlows @relation("FlowProgress", fields: [flowId], references: [id])
  step             EmployeeOnboardingSteps @relation("StepProgress", fields: [stepId], references: [id])
  feature          OnboardingStepFeatures  @relation("FeatureProgress", fields: [stepFeatureId], references: [id])
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  deletedAt        DateTime?               @map("deleted_at")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model OrganizationEmployees {
  id                 String                    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String                    @map("organization_id") @db.ObjectId
  categoryId         String?                   @map("category_id") @db.ObjectId
  designationId      String?                   @map("designation_id") @db.ObjectId
  firstName          String?                   @map("first_name")
  lastName           String?                   @map("last_name")
  fullName           String                    @map("full_name")
  employeeCode       String?                   @map("employee_code")
  accessToken        String?                   @map("access_token")
  refreshToken       String?                   @map("refresh_token")
  email              String?
  phone              String
  altPhone           String?                   @map("alt_phone")
  gender             Gender
  dateOfBirth        DateTime                  @map("date_of_birth")
  reportingTo        EmployeeDepartments[]     @relation("reporting_to_employee")
  headingDepartments OrganizationDepartments[] @relation("DepartmentHead") // ✅ matches new relation

  organization            Organizations              @relation(fields: [organizationId], references: [id])
  category                EmployeeCategories?        @relation(fields: [categoryId], references: [id])
  designation             OrganizationDesignations?  @relation("DesignationEmployees", fields: [designationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assetAssignment         AssetAssignments[]
  attendance              Attendance[]
  departmentAssignments   EmployeeDepartments[]
  pollPosts               Posts[]
  pollLikes               PostLikes[]
  pollComments            PostComments[]
  pollSaves               PostSaves[]
  pollShares              PostShares[]
  pollVotes               PostVotes[]
  onboardingProgress      OnboardingProgress[]       @relation("EmployeeOnboardingProgress")
  approvedRequests        AssetRequest[]             @relation("ApprovedBy")
  acknowledgedConditions  AssetCondition[]           @relation("AcknowledgedBy")
  EmployeeShiftAssignment EmployeeShiftAssignment[]
  regularisations         AttendanceRegularisation[]
  leaveRequests           LeaveRequests[]
  workrequests            WorkdayRequests[]

  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  deletedAt               DateTime?                 @map("deleted_at")
  organizationDepartments OrganizationDepartments[]
  assetConditions         AssetCondition[]
  attendanceReports       AttendanceReports[]
  salaryStructures        SalaryStructure[]
  salaryRevisions         SalaryRevision[]
  payslips                Payslip[]
}

model EmployeeDepartments {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  departmentId String                  @map("department_id") @db.ObjectId
  department   OrganizationDepartments @relation(fields: [departmentId], references: [id])
  employeeId   String                  @map("employee_id") @db.ObjectId
  employee     OrganizationEmployees   @relation(fields: [employeeId], references: [id])
  reportingTo  String?                 @map("reporting_to") @db.ObjectId
  reporting    OrganizationEmployees?  @relation("reporting_to_employee", fields: [reportingTo], references: [id])
  startDate    DateTime                @map("start_date")
  endDate      DateTime?               @map("end_date")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  deletedAt    DateTime?               @map("deleted_at")
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  HOLIDAY
}

enum LogType {
  CHECK_IN
  CHECK_OUT
  ADJUSTMENT
}

enum AttendanceMode {
  OFFICE
  WORK_FROM_HOME
  ON_DUTY
  PARTIAL_DAY
}

model Attendance {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String    @map("organization_id") @db.ObjectId
  employeeId         String    @map("employee_id") @db.ObjectId
  date               DateTime  @db.Date
  checkIn            DateTime? @map("check_in")
  checkOut           DateTime? @map("check_out")
  location           Json?
  grossHours         Float?    @map("gross_hours")
  effectiveHours     Float?    @map("effective_hours")
  lateArrivalMinutes Int?      @map("late_arrival_minutes")

  status    AttendanceStatus @default(PENDING)
  isHoliday Boolean          @default(false) @map("is_holiday")
  requests  Json?
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  mode      AttendanceMode?  @default(OFFICE)

  // Relations
  organization    Organizations              @relation(fields: [organizationId], references: [id])
  employee        OrganizationEmployees      @relation(fields: [employeeId], references: [id])
  logs            AttendanceLogs[]
  regularisations AttendanceRegularisation[]
  workrequests    WorkdayRequests[]
}

enum ReportStatuses {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
}

model AttendanceReports {
  id             String                    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                    @map("organization_id") @db.ObjectId
  departmentId   String?                   @map("department_id") @db.ObjectId
  designationId  String?                   @map("designation_id") @db.ObjectId
  employeeId     String?                   @map("employee_id") @db.ObjectId
  organization   Organizations             @relation(fields: [organizationId], references: [id])
  employee       OrganizationEmployees?    @relation(fields: [employeeId], references: [id])
  designation    OrganizationDesignations? @relation(fields: [designationId], references: [id])
  department     OrganizationDepartments?  @relation(fields: [departmentId], references: [id])
  startDate      DateTime?                 @map("start_date")
  endDate        DateTime?                 @map("end_date")
  pdfUrl         String?                   @map("pdf_url")
  status         ReportStatuses            @default(INITIATED)
  initiatedAt    DateTime?                 @map("initiated_at")
  startedAt      DateTime?                 @map("started_at")
  completedAt    DateTime?                 @map("completed_at")
  failedAt       DateTime?                 @map("failed_at")
  failingReason  String?
  responseData   Json?                     @map("response_data")
}

model AttendanceLogs {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  attendanceId String     @map("attendance_id") @db.ObjectId
  type         LogType    @map("type")
  ipAddress    String?
  geoLocation  Json?
  source       String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  attendance   Attendance @relation(fields: [attendanceId], references: [id])
}

model Shifts {
  id               String                    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String                    @db.ObjectId
  name             String
  startTime        DateTime
  endTime          DateTime
  breakMinutes     Int?
  applicableDays   Json?                     @map("applicable_days")
  weeklyOff        String[]
  organization     Organizations             @relation(fields: [organizationId], references: [id])
  shiftAssignments EmployeeShiftAssignment[]
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  deletedAt        DateTime?                 @map("deleted_at")
}

enum RegularisationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceRegularisation {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  attendanceId String                 @db.ObjectId
  employeeId   String                 @db.ObjectId
  reason       String
  status       RegularisationStatus   @default(PENDING)
  requestedAt  DateTime               @default(now())
  approvedAt   DateTime?
  approvedBy   String?                @map("approved_by") @db.ObjectId
  remarks      String?
  attendance   Attendance?            @relation(fields: [attendanceId], references: [id])
  employee     OrganizationEmployees? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  deletedAt    DateTime?              @map("deleted_at")
}

model ApprovalFlows {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  organizationId    String               @map("organization_id") @db.ObjectId
  entityType        String // LEAVE, REGULARISATION, etc.
  organization      Organizations        @relation(fields: [organizationId], references: [id])
  levels            ApprovalFlowLevels[]
  approvalInstances ApprovalInstance[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")
}

model ApprovalLogs {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  approvalId     String     @map("approval_id") @db.ObjectId
  organizationId String     @map("organization_id") @db.ObjectId
  entityId       String     @map("entity_id") @db.ObjectId
  entityType     EntityType
  level          Int
  approverId     String?    @map("approver_id") @db.ObjectId
  action         String // APPROVED, REJECTED, AUTO_APPROVED etc
  remarks        String?
  approvedAt     DateTime   @default(now())

  approval     ApprovalInstance @relation(fields: [approvalId], references: [id])
  organization Organizations    @relation(fields: [organizationId], references: [id])
}

enum EntityType {
  LEAVE
  REGULARISATION
  WORKDAY
}

model ApprovalInstance {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String @map("organization_id") @db.ObjectId

  entityId   String     @map("entity_id") @db.ObjectId
  entityType EntityType // LEAVE / REGULARISATION / WORKDAY etc

  flowId       String @map("flow_id") @db.ObjectId
  currentLevel Int
  status       String // PENDING / IN_PROGRESS / COMPLETED / REJECTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs         ApprovalLogs[]
  flow         ApprovalFlows  @relation(fields: [flowId], references: [id])
  organization Organizations  @relation(fields: [organizationId], references: [id])
}

model ApprovalFlowLevels {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  flowId          String  @map("flow_id") @db.ObjectId
  level           Int
  autoApproveDays Int?    @default(3)
  escalationRole  String?
  isActive        Boolean @default(true)

  flow      ApprovalFlows           @relation(fields: [flowId], references: [id])
  approvers ApprovalFlowApprovers[]
}

model ApprovalFlowApprovers {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  levelId        String             @map("level_id") @db.ObjectId
  userId         String?            @map("user_id") @db.ObjectId // direct approver
  role           String? // MANAGER / HR / LEAD
  organizationId String?            @map("organization_id") @db.ObjectId
  organization   Organizations?     @relation(fields: [organizationId], references: [id])
  level          ApprovalFlowLevels @relation(fields: [levelId], references: [id])
}

enum HolidayType {
  PUBLIC // company-wide public holiday
  RESTRICTED // optional / restricted holiday
  OPTIONAL // if you want a separate flag from restricted
  WEEK_OFF // e.g. company-wide off on a special day
  COMPANY_EVENT // e.g. annual day, foundation day
}

model Holidays {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String @db.ObjectId

  policyId String?          @map("policy_id") @db.ObjectId // 👈 NEW
  policy   HolidayPolicies? @relation(fields: [policyId], references: [id])

  date   DateTime
  name   String
  region String?
  type   HolidayType @default(PUBLIC)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

model EmployeeShiftAssignment {
  id         String                @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String                @map("employee_id") @db.ObjectId
  shiftId    String                @map("shift_id") @db.ObjectId
  validFrom  DateTime
  validTo    DateTime?
  employee   OrganizationEmployees @relation(fields: [employeeId], references: [id])
  shift      Shifts                @relation(fields: [shiftId], references: [id])
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  deletedAt  DateTime?             @map("deleted_at")
}

model GeoFences {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String  @map("organization_id") @db.ObjectId
  name           String // e.g., "Head Office"
  latitude       Float // center lat
  longitude      Float // center lng
  radiusMeters   Int // allowed radius (meters)
  isActive       Boolean @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveTypes {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String @map("organization_id") @db.ObjectId

  name        String // "Casual Leave"
  code        String // "CL"
  description String?

  paid       Boolean @default(true)
  maxPerYear Int?    @map("max_per_year") // total allowed per year

  allowHalfDay      Boolean @default(true) // half day allowed?
  requiresDocument  Boolean @default(false) // require proof after N days
  documentAfterDays Int?    @default(2) // e.g. medical certificate

  carryForward      Boolean @default(true)
  maxCarryForward   Int?    @default(12)
  encashmentAllowed Boolean @default(false)
  maxEncashPerYear  Int?    @default(0)

  genderRestriction String? // "MALE" | "FEMALE" | "NONE"

  probationAllowed Boolean @default(false)
  minServiceMonths Int?    @default(3)

  maxConsecutiveDays Int?    @default(7)
  sandwichRule       Boolean @default(true)

  accrualEnabled     Boolean @default(true)
  accrualFrequency   String  @default("monthly") // daily | monthly | yearly
  accrueAfterDays    Int?    @default(30)
  monthlyAccrualRate Float?  @default(1.0) // KEKA: 1 CL / month

  isActive Boolean @default(true)

  organization  Organizations   @relation(fields: [organizationId], references: [id])
  leaveRequests LeaveRequests[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model LeaveRequests {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  employeeId     String @map("employee_id") @db.ObjectId
  organizationId String @map("organization_id") @db.ObjectId
  leaveTypeId    String @map("leave_type_id") @db.ObjectId

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  totalDays   Float?   @map("total_days") // full + half days
