// ============================================================================
// 🧩 COMPONENT DEFINITION (Library/Master)
// ============================================================================

model ComponentDefinition {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  key      String // e.g., "basic", "hra", "pf_employee"
  name     String // Display name: "Basic Salary"
  type     String // earning, deduction, reimbursement, benefit, tax
  category String @default("recurring") // recurring, adhoc, allowance, custom

  // Formula & Configuration
  defaultFormula String? // e.g., "gross * 0.5"
  description    String?

  // Behavior Flags
  isTaxable      Boolean @default(true)
  isVariable     Boolean @default(false)
  isStatutory    Boolean @default(false)
  includeInCTC   Boolean @default(true)
  includeInGross Boolean @default(true)

  // Display
  displayOrder Int     @default(999)
  isActive     Boolean @default(true)

  isDefault   Boolean @default(false)
  isDeletable Boolean @default(true)

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Foreign Keys
  organizationId String        @map("organization_id") @db.ObjectId
  organization   Organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  templateComponents  TemplateComponent[]
  structureComponents StructureComponent[]
}

// ============================================================================
// 📋 SALARY TEMPLATE (Reusable Structure)
// ============================================================================
model SalaryTemplate {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @map("organization_id") @db.ObjectId
  organization   Organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  departments  String[]
  designations String[]
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)

  // Versioning
  version        Int              @default(1)
  baseTemplateId String?          @map("base_template_id") @db.ObjectId
  baseTemplate   SalaryTemplate?  @relation("TemplateVersions", fields: [baseTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions       SalaryTemplate[] @relation("TemplateVersions")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  ranges             SalaryTemplateRange[]
  templateComponents TemplateComponent[]
  salaryStructures   SalaryStructure[]
}

model SalaryTemplateRange {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  templateId String         @map("template_id") @db.ObjectId
  template   SalaryTemplate @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // either gross slabs OR ctc slabs (you can keep both)
  grossLow  Float?  @map("gross_low")
  grossHigh Float?  @map("gross_high") // null means infinity
  ctcLow    Float?  @map("ctc_low")
  ctcHigh   Float?  @map("ctc_high") // null means infinity
  label     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // components mapped to this range
  components TemplateComponent[]
}

enum ComponentKind {
  EARNING
  EMPLOYEE
  EMPLOYER
}

model TemplateComponent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  kind      ComponentKind?
  formula   String?
  value     Float?
  priority  Int            @default(0)
  minValue  Float?
  maxValue  Float?
  condition String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Foreign Keys
  templateId String         @map("template_id") @db.ObjectId
  template   SalaryTemplate @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // NEW: range mapping
  rangeId String?              @map("range_id") @db.ObjectId
  range   SalaryTemplateRange? @relation(fields: [rangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  componentId String              @map("component_id") @db.ObjectId
  component   ComponentDefinition @relation(fields: [componentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ============================================================================
// 💼 SALARY STRUCTURE (Employee-Specific)
// ============================================================================

model SalaryStructure {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Base Values
  grossAnnual   Float // Annual CTC
  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Calculation Settings
  deductFromInHand Boolean @default(false)

  // Computed Totals (cached for performance)
  totalEarnings   Float?
  totalDeductions Float?
  totalBenefits   Float?
  inHandAnnual    Float?
  inHandMonthly   Float?

  // Status
  status          String  @default("ACTIVE") // ACTIVE, INACTIVE, SUPERSEDED
  isCurrentActive Boolean @default(true)

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Foreign Keys
  employeeId String                @map("employee_id") @db.ObjectId
  employee   OrganizationEmployees @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  templateId String?         @map("template_id") @db.ObjectId
  template   SalaryTemplate? @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Relations
  components      StructureComponent[]
  payslips        Payslip[]
  revisionHistory SalaryRevision[]
  revisions       SalaryRevision[]     @relation("currentStructure")
}

model StructureComponent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Component Value
  formula String?
  value   Float? // Fixed value or computed result

  // Annual & Monthly Breakdown
  annualAmount  Float
  monthlyAmount Float

  // Override Flags
  isOverridden Boolean @default(false)
  overrideNote String?

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Foreign Keys
  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  componentId String
  component   ComponentDefinition @relation(fields: [componentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// ============================================================================
// 📊 SALARY REVISION HISTORY
// ============================================================================

model SalaryRevision {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Revision Details
  revisionType  String // INCREMENT, PROMOTION, ANNUAL_REVIEW, CORRECTION
  revisionDate  DateTime
  effectiveDate DateTime

  // Changes
  previousGross Float
  newGross      Float
  changePercent Float?
  changeAmount  Float?

  // Justification
  reason       String?
  approvedBy   String?
  approvalDate DateTime?

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  structureId String?
  structure   SalaryStructure? @relation(name: "currentStructure", fields: [structureId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Foreign Keys
  employeeId String
  employee   OrganizationEmployees @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  oldStructureId String?
  oldStructure   SalaryStructure? @relation(fields: [oldStructureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ============================================================================
// 💰 PAYSLIP (Monthly Salary Slip)
// ============================================================================

model Payslip {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Period
  month       Int // 1-12
  year        Int
  paymentDate DateTime?

  // Salary Breakdown
  grossPay        Float
  totalEarnings   Float
  totalDeductions Float
  netPay          Float

  // Additional Adjustments
  arrears Float @default(0)
  bonus   Float @default(0)
  penalty Float @default(0)

  // Working Days
  totalWorkingDays  Int
  actualWorkingDays Int
  leaveDays         Int @default(0)
  lopDays           Int @default(0) // Loss of Pay

  // Status
  status      String    @default("DRAFT") // DRAFT, GENERATED, APPROVED, PAID
  generatedAt DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?

  // Payment
  paymentMethod String? // BANK_TRANSFER, CHEQUE, CASH
  paymentRef    String?

  // Notes
  remarks String?

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Foreign Keys
  employeeId String
  employee   OrganizationEmployees @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Relations
  components PayslipComponent[]
}

model PayslipComponent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  componentKey  String // From ComponentDefinition.key
  componentName String // Display name
  componentType String // earning, deduction, etc.

  amount  Float
  remarks String?

  // Foreign Keys
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model TrafficEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  timestamp DateTime @default(now())

  // Identity
  organizationId String?
  userId         String?
  role           String?
  requestId      String? // trace / correlation ID

  // Classification
  service  String
  module   String?
  endpoint String // raw path
  routeKey String? // normalized path: /leave/:id
  method   String

  // Result
  statusCode     Int
  statusClass    String // 2xx | 4xx | 5xx
  success        Boolean
  responseTimeMs Int
  errorType      String? // validation | auth | timeout | server

  // Size (optional but powerful)
  requestSizeBytes  Int?
  responseSizeBytes Int?

  // Client
  ip        String?
  userAgent String?
  source    String? // web | mobile | api | system
  country   String? // optional (from IP later)

  // Flags
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([timestamp])
  @@index([service, timestamp])
  @@index([organizationId, timestamp])
  @@index([routeKey, timestamp])
}

model TrafficHourlyStat {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  hour           DateTime
  organizationId String?
  service        String
  module         String?

  requestCount Int
  successCount Int
  errorCount   Int

  avgLatencyMs Float
  p95LatencyMs Float
  p99LatencyMs Float

  uniqueUsers Int

  createdAt DateTime @default(now())

  @@unique([hour, organizationId, service, module])
  @@index([hour])
}

model TrafficDailyStat {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  date           DateTime
  organizationId String?
  service        String
  module         String?

  requestCount Int
  successCount Int
  errorCount   Int

  avgLatencyMs Float
  p95LatencyMs Float
  p99LatencyMs Float

  activeUsers Int

  createdAt DateTime @default(now())

  @@unique([date, organizationId, service, module])
  @@index([date])
}

model TrafficAlertRule {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  isActive Boolean @default(true)

  // Scope
  organizationId String? // null => platform-wide
  service        String? // null => all
  module         String? // null => all

  // Types: ERROR_RATE | LATENCY_P95 | REQUEST_SPIKE
  type String

  // Generic threshold fields (interpret by type)
  threshold     Float
  windowMinutes Int   @default(15)

  minRequests Int @default(50)

  // Avoid spam
  cooldownMinutes Int       @default(60)
  lastTriggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, type])
}

model TrafficAlert {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ruleId      String
  triggeredAt DateTime @default(now())

  organizationId String?
  service        String?
  module         String?

  type          String
  value         Float
  threshold     Float
  windowMinutes Int

  message String

  createdAt DateTime @default(now())

  @@index([triggeredAt])
  @@index([type, triggeredAt])
}

model OrganizationUsageEvent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /**
   * 🔐 Organization & Actor
   */
  organizationId String  @db.ObjectId
  employeeId     String? @db.ObjectId
  role           String? // ADMIN, HR, EMPLOYEE, SYSTEM

  /**
   * 🧩 What was used
   */
  module       String // leave, payroll, attendance
  feature      String? // apply_leave, approve_leave
  action       String // VIEW, CREATE, UPDATE, DELETE
  resourceType String? // LEAVE, EMPLOYEE, PAYROLL
  resourceId   String? @db.ObjectId

  /**
   * 🌐 API / UI Tracking
   */
  source   String  @default("UI") // UI, API, CRON, WEBHOOK
  endpoint String?
  method   String?

  /**
   * ⏱️ Metrics
   */
  durationMs   Int?
  statusCode   Int?
  success      Boolean @default(true)
  errorCode    String?
  errorMessage String?

  /**
   * 📊 Usage Quantification
   */
  usageUnit  String? // request, record, run
  usageCount Int     @default(1)

  /**
   * 🕒 Time
   */
  occurredAt DateTime @default(now())
  date       DateTime // normalized date (YYYY-MM-DD)

  /**
   * 🧠 Metadata
   */
  metadata Json?

  /**
   * 🧹 Soft delete
   */
  deletedAt DateTime?

  @@index([organizationId, date])
  @@index([organizationId, module])
  @@index([organizationId, feature])
  @@index([occurredAt])
  @@index([success, statusCode])
}
