model EmployeeDocumentType {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  folderId               String    @map("folder_id") @db.ObjectId
  name                   String
  description            String?
  isMultiple             Boolean   @default(false) @map("is_multiple")
  isMandatory            Boolean   @default(false) @map("is_mandatory")
  isAppliableNA          Boolean   @default(false) @map("is_applicable_na")
  isFileUploadEnabled    Boolean   @default(false) @map("is_file_upload_enabled")
  isVerificationRequired Boolean   @default(false) @map("is_verification_required")
  askExpiryDate          Boolean   @default(false) @map("ask_expiry_date")
  expiryDays             Int?      @map("expiry_days")
  expiryPeriod           String?   @map("expiry_period") // DAY | WEEK | MONTH | YEAR
  allCountries           Boolean   @default(true) @map("all_countries")
  allowedCountries       String[]  @default([]) @map("allowed_countries")
  displayOrder           Int       @default(0) @map("display_order")
  isActive               Boolean   @default(true) @map("is_active")
  createdById            String?   @map("created_by_id") @db.ObjectId
  updatedById            String?   @map("updated_by_id") @db.ObjectId
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  folder      EmployeeDocumentFolder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fields      EmployeeDocumentField[]
  assignments EmployeeDocumentAssignment[]
  submissions EmployeeDocumentSubmission[]

  @@unique([folderId, name])
  @@index([folderId, displayOrder])
  @@index([folderId, isActive])
}

model EmployeeDocumentField {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  documentTypeId String    @map("document_type_id") @db.ObjectId
  label          String
  key            String
  fieldType      String    @map("field_type") // TEXTBOX | NUMBER | DATE | TEXTAREA | DROPDOWN | FILE
  options        Json?
  isMandatory    Boolean   @default(false) @map("is_mandatory")
  displayOrder   Int       @default(0) @map("display_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  documentType EmployeeDocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@index([documentTypeId, displayOrder])
}

model EmployeeDocumentAssignment {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                 @map("organization_id") @db.ObjectId
  employeeId     String                 @map("employee_id") @db.ObjectId
  documentTypeId String                 @map("document_type_id") @db.ObjectId
  assignedById   String?                @map("assigned_by_id") @db.ObjectId
  assignedAt     DateTime?              @map("assigned_at")
  status         EmployeeDocumentStatus @default(PENDING)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  deletedAt      DateTime?              @map("deleted_at")

  organization Organizations                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     OrganizationEmployees        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType EmployeeDocumentType         @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  submissions  EmployeeDocumentSubmission[]

  @@unique([employeeId, documentTypeId])
  @@index([employeeId])
  @@index([documentTypeId])
  @@index([organizationId])
}

model EmployeeDocumentSubmission {
  id                     String                 @id @default(auto()) @map("_id") @db.ObjectId
  organizationId         String                 @map("organization_id") @db.ObjectId
  assignmentId           String                 @map("assignment_id") @db.ObjectId
  employeeId             String                 @map("employee_id") @db.ObjectId
  documentTypeId         String                 @map("document_type_id") @db.ObjectId
  fileId                 String?                @map("file_id") @db.ObjectId
  storageKey             String?                @map("storage_key")
  fileName               String?                @map("file_name")
  fileType               String?                @map("file_type")
  fieldValues            Json?                  @map("field_values")
  isNA                   Boolean                @default(false) @map("is_na")
  status                 EmployeeDocumentStatus @default(PENDING)
  submittedById          String?                @map("submitted_by_id") @db.ObjectId
  submittedByType        DocumentActorType?     @map("submitted_by_type")
  submittedAt            DateTime?              @map("submitted_at")
  verifiedById           String?                @map("verified_by_id") @db.ObjectId
  verifiedByType         DocumentActorType?     @map("verified_by_type")
  verifiedAt             DateTime?              @map("verified_at")
  rejectedById           String?                @map("rejected_by_id") @db.ObjectId
  rejectedByType         DocumentActorType?     @map("rejected_by_type")
  rejectedAt             DateTime?              @map("rejected_at")
  rejectionReason        String?                @map("rejection_reason")
  replacedBySubmissionId String?                @map("replaced_by_submission_id") @db.ObjectId
  expiryDate             DateTime?              @map("expiry_date")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  deletedAt              DateTime?              @map("deleted_at")

  organization Organizations              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment   EmployeeDocumentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  employee     OrganizationEmployees      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType EmployeeDocumentType       @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([documentTypeId])
  @@index([assignmentId])
  @@index([status])
  @@index([replacedBySubmissionId])
}

model EmployeeRelationship {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String           @map("organization_id") @db.ObjectId
  employeeId     String           @map("employee_id") @db.ObjectId
  relationship   RelationshipType
  firstName      String           @map("first_name")
  lastName       String?          @map("last_name")
  gender         Gender?
  email          String?
  phone          String?
  profession     String?
  dateOfBirth    DateTime?        @map("date_of_birth")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  organization Organizations         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     OrganizationEmployees @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([organizationId])
}

model OrganizationDocumentFolder {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String  @map("organization_id") @db.ObjectId
  name           String
  description    String?
  isConfidential Boolean @default(false) @map("is_confidential")
  isActive       Boolean @default(true) @map("is_active")

  legalEntityIds   String[] @default([]) @map("legal_entity_ids")
  branchIds        String[] @default([]) @map("branch_ids")
  locationIds      String[] @default([]) @map("location_ids")
  departmentIds    String[] @default([]) @map("department_ids")
  subDepartmentIds String[] @default([]) @map("sub_department_ids")
  workerTypes      String[] @default([]) @map("worker_types")

  permissions Json?
  createdById String?   @map("created_by_id") @db.ObjectId
  updatedById String?   @map("updated_by_id") @db.ObjectId
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organization Organizations          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    OrganizationDocument[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model OrganizationDocument {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId          String    @map("organization_id") @db.ObjectId
  folderId                String    @map("folder_id") @db.ObjectId
  name                    String
  description             String?
  allowDownload           Boolean   @default(true) @map("allow_download")
  acknowledgementRequired Boolean   @default(false) @map("acknowledgement_required")
  blockUntilAcknowledged  Boolean   @default(false) @map("block_until_acknowledged")
  askExpiryDate           Boolean   @default(false) @map("ask_expiry_date")
  expiryDate              DateTime? @map("expiry_date")
  fileId                  String?   @map("file_id") @db.ObjectId
  storageKey              String?   @map("storage_key")
  fileName                String?   @map("file_name")
  fileType                String?   @map("file_type")
  fileSize                Int?      @map("file_size")
  createdById             String?   @map("created_by_id") @db.ObjectId
  updatedById             String?   @map("updated_by_id") @db.ObjectId
  isActive                Boolean   @default(true) @map("is_active")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  organization     Organizations                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder           OrganizationDocumentFolder            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  views            OrganizationDocumentView[]
  acknowledgements OrganizationDocumentAcknowledgement[]

  @@index([organizationId])
  @@index([folderId])
}

model OrganizationDocumentView {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @map("organization_id") @db.ObjectId
  documentId     String   @map("document_id") @db.ObjectId
  employeeId     String   @map("employee_id") @db.ObjectId
  viewedAt       DateTime @default(now()) @map("viewed_at")

  organization Organizations         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     OrganizationDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee     OrganizationEmployees @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([documentId, employeeId])
  @@index([documentId])
  @@index([employeeId])
  @@index([organizationId])
}

model OrganizationDocumentAcknowledgement {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @map("organization_id") @db.ObjectId
  documentId     String   @map("document_id") @db.ObjectId
  employeeId     String   @map("employee_id") @db.ObjectId
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  organization Organizations         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     OrganizationDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee     OrganizationEmployees @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([documentId, employeeId])
  @@index([documentId])
  @@index([employeeId])
  @@index([organizationId])
}
