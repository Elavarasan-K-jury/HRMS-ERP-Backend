generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admins {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String
  phone        String
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  roleAssignments AdminRoleAssignments[]
  auditLogs       AdminAuditLog[]
  configUpdates   SystemConfig[]
}

model Otps {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  adminId        String?   @map("admin_id") @db.ObjectId
  employeeId     String?   @map("employee_id") @db.ObjectId
  organizationId String?   @map("organization_id") @db.ObjectId
  otp            String
  purpose        String?
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
}

model Branches {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String         @map("organization_id") @db.ObjectId
  name           String
  code           String?
  description    String?
  legalEntityId  String?        @map("legal_entity_id") @db.ObjectId
  isActive       Boolean        @default(true) @map("is_active")
  organization   Organizations  @relation(fields: [organizationId], references: [id])
  legalEntity    LegalEntities? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  employees OrganizationEmployees[]
}

model Locations {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String    @map("organization_id") @db.ObjectId
  entityType       String    @map("entity_type") // 'organization' | 'branch'
  entityId         String?   @map("entity_id") @db.ObjectId
  isHeadquarters   Boolean   @default(false) @map("is_headquarters")
  name             String?
  timezone         String?
  country          String?
  state            String?
  address1         String?   @map("address_1")
  address2         String?   @map("address_2")
  city             String?
  pincode          String?
  description      String?
  latitude         Float?
  longitude        Float?
  placeId          String?   @map("place_id")
  formattedAddress String?   @map("formatted_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  employees OrganizationEmployees[]
}

model Organizations {
  id                            String                          @id @default(auto()) @map("_id") @db.ObjectId
  name                          String
  domain                        String                          @unique
  GSTNumber                     String?                         @map("gst_number")
  email                         String?
  contactPersonName             String?                         @map("contact_person_name")
  contactPersonNumber           String?                         @map("contact_person_number")
  accessToken                   String?                         @map("access_token")
  refreshToken                  String?                         @map("refresh_token")
  note                          String?
  industry                      String?
  size                          Int?
  activeEmployee                Int?                            @default(0)
  totalEmployee                 Int?                            @default(0)
  address                       Json?
  createdAt                     DateTime                        @map("created_at")
  updatedAt                     DateTime                        @map("updated_at")
  deletedAt                     DateTime?                       @map("deleted_at")
  attendance                    Attendance[]
  departments                   OrganizationDepartments[]
  designations                  OrganizationDesignations[]
  employees                     OrganizationEmployees[]
  employeeNumberSeries          EmployeeNumberSeries[]
  categories                    EmployeeCategories[]
  shifts                        Shifts[]
  holidays                      Holidays[]
  leaveTypes                    LeaveTypes[]
  geoFences                     GeoFences[]
  attendancePolicies            AttendancePolicies[]
  shiftPolicies                 ShiftPolicies[]
  holidayPolicies               HolidayPolicies[]
  probationPolicies             ProbationPolicies[]
  probationEvaluationMilestones ProbationEvaluationMilestones[]
  networkpolicies               NetworkPolicies[]
  approvalLogs                  ApprovalLogs[]
  approvalInstances             ApprovalInstance[]
  approvers                     ApprovalFlowApprovers[]
  leaveRequests                 LeaveRequests[]
   workrequests                  WorkdayRequests[]
   approvalflows                 ApprovalFlows[]

   smsNotification      Boolean @default(false)
  emailNotification    Boolean @default(true)
  whatsappNotification Boolean @default(false)
  pushNotification     Boolean @default(true)

  maxEmployees              Int?                        @default(20) @map("max_employees")
  maxStorageInGB            Int?                        @default(10) @map("max_storage_in_gb")
  maxApiRatePerMin          Int?                        @default(1000) @map("max_api_rate_per_minute")
  maxPayrollRunsPerMonth    Int?                        @default(1) @map("max_payout_runs_per_month")
  maxLeavePolicies          Int?                        @default(5) @map("max_leave_policies")
  maxAdminAccounts          Int?                        @default(3) @map("max_admin_accounts")
  attendanceReports         AttendanceReports[]
  salaryComponentDefinition ComponentDefinition[]
  salaryTemplates           SalaryTemplate[]
  organizationFinanc        OrgaizationFinance?
  folders                   Folders[]
  files                     Files[]
  payslipTemplates          PayslipTemplates[]
  expenses                  Expenses[]
  branches                  Branches[]
  legalEntities             LegalEntities[]

  adminRoles                  AdminRoles[]
  adminRoleAssignments        AdminRoleAssignments[]
  employeeRoleAssignments     EmployeeRoleAssignments[]
  auditLogs                   AdminAuditLog[]
  payGrades                   PayGrades[]
  noticePeriodPolicies        NoticePeriodPolicy[]
  usageTypes                  UsageType[]
  expenseCategories           ExpenseCategory[]
  expensePolicies             ExpensePolicy[]
  policyExpenseCategories     PolicyExpenseCategory[]
  expensePolicyEmployees      ExpensePolicyEmployee[]
  employeeDocumentFolders     EmployeeDocumentFolder[]
  employeeDocumentAssignments EmployeeDocumentAssignment[]
  employeeDocumentSubmissions EmployeeDocumentSubmission[]
  employeeRelationships       EmployeeRelationship[]
  orgDocumentFolders          OrganizationDocumentFolder[]
  orgDocuments                OrganizationDocument[]
  orgDocumentViews            OrganizationDocumentView[]
  orgDocumentAcks             OrganizationDocumentAcknowledgement[]
}

model PayGrades {
  id             String                  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                  @map("organization_id") @db.ObjectId
  name           String
  description    String?
  organization   Organizations           @relation(fields: [organizationId], references: [id])
  employees      OrganizationEmployees[]
  createdAt      DateTime                @map("created_at")
  updatedAt      DateTime                @map("updated_at")
  deletedAt      DateTime?               @map("deleted_at")

  @@unique([organizationId, name])
}

model NoticePeriodPolicy {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @map("organization_id") @db.ObjectId
  title          String
  description    String?
  durationValue  Int           @default(0)
  durationUnit   String        @default("DAYS")
  isDefault      Boolean       @default(false)
  status         String        @default("PENDING")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  organization   Organizations @relation(fields: [organizationId], references: [id])

  employees NoticePeriodPolicyEmployee[]

  @@unique([organizationId, title])
  @@index([organizationId])
}

model NoticePeriodPolicyEmployee {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String    @map("organization_id") @db.ObjectId
  policyId       String    @map("policy_id") @db.ObjectId
  employeeId     String    @map("employee_id") @db.ObjectId
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  policy   NoticePeriodPolicy    @relation(fields: [policyId], references: [id])
  employee OrganizationEmployees @relation(fields: [employeeId], references: [id])

  @@unique([policyId, employeeId])
  @@index([policyId])
  @@index([employeeId])
}

model UsageType {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String    @map("organization_id") @db.ObjectId
  name           String
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization      Organizations     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseCategories ExpenseCategory[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model ExpenseCategory {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String    @map("organization_id") @db.ObjectId
  name           String
  expenseCode    String    @map("expense_code")
  icon           String?
  description    String?
  usageTypeId    String    @map("usage_type_id") @db.ObjectId
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization     Organizations           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usageType        UsageType               @relation(fields: [usageTypeId], references: [id])
  policyCategories PolicyExpenseCategory[]

  @@unique([organizationId, name])
  @@unique([organizationId, expenseCode])
  @@index([organizationId, usageTypeId])
}

model ExpensePolicy {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId        String    @map("organization_id") @db.ObjectId
  name                  String
    description    String?
  baseCurrency          String    @map("base_currency")
  payoutMode            String?   @map("payout_mode")
  allowFutureDateClaims Boolean   @default(false) @map("allow_future_date_claims")
  approvalRequired      Boolean   @default(false) @map("approval_required")
  approvalMode          String?   @map("approval_mode") // SAME_FOR_ALL | BY_CATEGORY
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  organization     Organizations                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalLevels   ExpensePolicyApprovalLevel[]
  policyCategories PolicyExpenseCategory[]
  policyEmployees  ExpensePolicyEmployee[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model ExpensePolicyApprovalLevel {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  expensePolicyId String    @map("expense_policy_id") @db.ObjectId
  level           Int
  approverType    String    @map("approver_type") // EMPLOYEE | ROLE
  approverId      String    @map("approver_id") @db.ObjectId
  approverName    String?   @map("approver_name")
  autoApprove     Boolean   @default(false) @map("auto_approve")
  autoApproveDays Int?      @map("auto_approve_days")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  expensePolicy ExpensePolicy @relation(fields: [expensePolicyId], references: [id], onDelete: Cascade)

  @@index([expensePolicyId, level])
}

model PolicyExpenseCategory {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId    String    @map("organization_id") @db.ObjectId
  expensePolicyId   String    @map("expense_policy_id") @db.ObjectId
  expenseCategoryId String    @map("expense_category_id") @db.ObjectId
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  organization    Organizations                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expensePolicy   ExpensePolicy                 @relation(fields: [expensePolicyId], references: [id], onDelete: Cascade)
  expenseCategory ExpenseCategory               @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  approvalLevels  PolicyCategoryApprovalLevel[]
  rules           ExpenseCategoryRule[]

  @@unique([expensePolicyId, expenseCategoryId])
  @@index([expensePolicyId])
  @@index([expenseCategoryId])
}

model ExpensePolicyEmployee {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String    @map("organization_id") @db.ObjectId
  expensePolicyId String    @map("expense_policy_id") @db.ObjectId
  employeeId      String    @map("employee_id") @db.ObjectId
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization  Organizations         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expensePolicy ExpensePolicy         @relation(fields: [expensePolicyId], references: [id], onDelete: Cascade)
  employee      OrganizationEmployees @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([expensePolicyId, employeeId])
  @@index([expensePolicyId])
  @@index([employeeId])
  @@index([organizationId])
}

model PolicyCategoryApprovalLevel {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  policyCategoryId String    @map("policy_category_id") @db.ObjectId
  level            Int
  approverType     String    @map("approver_type")
  approverId       String    @map("approver_id") @db.ObjectId
  approverName     String?   @map("approver_name")
  autoApprove      Boolean   @default(false) @map("auto_approve")
  autoApproveDays  Int?      @map("auto_approve_days")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  policyCategory PolicyExpenseCategory @relation(fields: [policyCategoryId], references: [id], onDelete: Cascade)

  @@index([policyCategoryId, level])
}

model ExpenseCategoryRule {
  id                       String    @id @default(auto()) @map("_id") @db.ObjectId
  policyCategoryId         String    @map("policy_category_id") @db.ObjectId
  amountCapEnabled         Boolean   @default(false) @map("amount_cap_enabled")
  amountCapCurrency        String?   @map("amount_cap_currency")
  amountCapAmount          Float?    @map("amount_cap_amount")
  amountCapPeriod          String?   @map("amount_cap_period") // Day, Week, Month, Quarter, Half Year, Year, Tenure
  combinationEnabled       Boolean   @default(false) @map("combination_enabled")
  combinationCategoryId    String?   @map("combination_category_id") @db.ObjectId
  combinationPeriod        String?   @map("combination_period")
  instancesEnabled         Boolean   @default(false) @map("instances_enabled")
  maxInstances             Int?      @map("max_instances")
  instancesPeriod          String?   @map("instances_period")
  expiryEnabled            Boolean   @default(false) @map("expiry_enabled")
  expiryDays               Int?      @map("expiry_days")
  costCenterRequired       Boolean   @default(false) @map("cost_center_required")
  commentThresholdEnabled  Boolean   @default(false) @map("comment_threshold_enabled")
  commentThresholdAmount   Float?    @map("comment_threshold_amount")
  receiptThresholdEnabled  Boolean   @default(false) @map("receipt_threshold_enabled")
  receiptThresholdAmount   Float?    @map("receipt_threshold_amount")
  thresholdApprovalEnabled Boolean   @default(false) @map("threshold_approval_enabled")
  thresholdCurrency        String?   @map("threshold_currency")
  thresholdAmount          Float?    @map("threshold_amount")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")

  policyCategory PolicyExpenseCategory @relation(fields: [policyCategoryId], references: [id], onDelete: Cascade)

  @@index([policyCategoryId])
}

model OrgaizationFinance {
  id                             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId                 String        @unique @map("organization_id") @db.ObjectId
  organization                   Organizations @relation(fields: [organizationId], references: [id])
  enablePf                       Boolean?      @default(false) @map("enable_pf")
  enableEsi                      Boolean?      @default(false) @map("enable_esi")
  enablePtax                     Boolean?      @default(false) @map("enable_ptax")
  pfFormula                      String?       @map("pf_formula")
  pfRegistrationNumber           String?       @map("pf_registration_number")
  pfRegisteredOrganizationName   String?       @map("pf_registered_organization_name")
  esiFormula                     String?       @map("esi_formula")
  esiRegistrationNumber          String?       @map("esi_registration_number")
  esiRegisteredOrganizationName  String?       @map("esi_registered_organization_name")
  ptaxFormula                    String?       @map("ptax_formula")
  ptaxRegistrationNumber         String?       @map("ptax_registration_number")
  ptaxRegisteredOrganizationName String?       @map("ptax_registered_organization_name")
  createdAt                      DateTime      @map("created_at")
  updatedAt                      DateTime      @map("updated_at")
  deletedAt                      DateTime?     @map("deleted_at")
}

model OrganizationDepartments {
  id                      String                     @id @default(auto()) @map("_id") @db.ObjectId
  organizationId          String                     @map("organization_id") @db.ObjectId
  name                    String
  code                    String?
  parentId                String?                    @map("parent_id") @db.ObjectId
  parent                  OrganizationDepartments?   @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children                OrganizationDepartments[]  @relation("DepartmentHierarchy")
  departmentHeadId        String?                    @map("department_head_id") @db.ObjectId
  departmentHeadStartDate DateTime?                  @map("department_head_start_date")
  departmentHead          OrganizationEmployees?     @relation("DepartmentHead", fields: [departmentHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description             String?
  note                    String?
  organization            Organizations              @relation(fields: [organizationId], references: [id])
  createdAt               DateTime                   @map("created_at")
  updatedAt               DateTime                   @map("updated_at")
  deletedAt               DateTime?                  @map("deleted_at")
  DepartmentDesignation   OrganizationDesignations[]
  DepartmentEmployees     EmployeeDepartments[]
  organizationEmployees   OrganizationEmployees?     @relation(fields: [organizationEmployeesId], references: [id])
  organizationEmployeesId String?                    @db.ObjectId
  attendanceReports       AttendanceReports[]
}

model OrganizationDesignations {
  id                String                   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId    String                   @map("organization_id") @db.ObjectId
  departmentId      String?                  @map("department_id") @db.ObjectId
  bandId            String?                  @map("band_id") @db.ObjectId
  name              String
  level             String?
  description       String?
  organization      Organizations            @relation(fields: [organizationId], references: [id])
  department        OrganizationDepartments? @relation(fields: [departmentId], references: [id])
  employees         OrganizationEmployees[]  @relation("DesignationEmployees")
  createdAt         DateTime                 @map("created_at")
  updatedAt         DateTime                 @map("updated_at")
  deletedAt         DateTime?                @map("deleted_at")
  attendanceReports AttendanceReports[]
}

model EmployeeCategories {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String  @map("organization_id") @db.ObjectId
  name           String
  description    String?
  isActive       Boolean @default(true) @map("is_active")

  // Employment type: "PROBATION" | "INTERNSHIP" | "TRAINEE" | "CONTRACT" | "PERMANENT"
  employmentType String @default("PROBATION") @map("employment_type")

  organization Organizations           @relation(fields: [organizationId], references: [id])
  employees    OrganizationEmployees[]

  createdAt DateTime  @map("created_at")
  updatedAt DateTime  @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model EmployeeNumberSeries {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String  @map("organization_id") @db.ObjectId
  name           String
  prefix         String  @default("")
  digits         Int     @default(4)
  suffix         String  @default("")
  nextNumber     Int     @default(1) @map("next_number")
  isActive       Boolean @default(true) @map("is_active")

  // Policy type this series serves: "PROBATION" | "INTERNSHIP" | "TRAINEE" | "CONTRACT" | "PERMANENT"
  policyType String @default("PROBATION") @map("policy_type")

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  organization Organizations @relation(fields: [organizationId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RelationshipType {
  CHILD
  FATHER
  FATHER_IN_LAW
  MOTHER
  MOTHER_IN_LAW
  OTHERS
  PARTNER
  SPOUSE
  SELF
  SIBLING
}

model OrganizationEmployees {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String    @map("organization_id") @db.ObjectId
  categoryId         String?   @map("category_id") @db.ObjectId
  designationId      String?   @map("designation_id") @db.ObjectId
  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  fullName           String    @map("full_name")
  employeeCode       String?   @map("employee_code")
  profileImage       String?   @map("profile_image")
  profileImageFileId String?   @map("profile_image_file_id") @db.ObjectId
  accessToken        String?   @map("access_token")
  refreshToken       String?   @map("refresh_token")
  email              String?
  phone              String
  isAdmin            Boolean   @default(false)
  isActive           Boolean   @default(true) @map("is_active")
  altPhone           String?   @map("alt_phone")
  gender             Gender
  dateOfBirth        DateTime  @map("date_of_birth")
  joiningDate        DateTime? @map("joining_date")

  displayName           String? @map("display_name")
  maritalStatus         String? @map("marital_status")
  bloodGroup            String? @map("blood_group")
  physicallyHandicapped Boolean @default(false) @map("physically_handicapped")
  nationality           String?
  personalEmail         String? @map("personal_email")
  professionalSummary   String? @map("professional_summary")
  about                 String? @map("about")
  whatILoveAboutJob     String? @map("what_i_love_about_job")
  interestsAndHobbies   String? @map("interests_and_hobbies")
  currentAddress        Json?   @map("current_address")
  permanentAddress      Json?   @map("permanent_address")

  probationPolicyId         String?   @map("probation_policy_id") @db.ObjectId
  probationStartDate        DateTime? @map("probation_start_date")
  probationEndDate          DateTime? @map("probation_end_date")
  probationExtendedByMonths Int?      @default(0) @map("probation_extended_by_months")
  isPermanent               Boolean   @default(false) @map("is_permanent")

  workerType String? @map("worker_type")

  reportingTo        EmployeeDepartments[]     @relation("reporting_to_employee")
  headingDepartments OrganizationDepartments[] @relation("DepartmentHead")

  costCenterId String?      @map("cost_center_id") @db.ObjectId

  payGradeId String?    @map("pay_grade_id") @db.ObjectId
  payGrade   PayGrades? @relation(fields: [payGradeId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  noticePeriodPolicies NoticePeriodPolicyEmployee[]
  policyAssignments    ExpensePolicyEmployee[]

  bandId String? @map("band_id") @db.ObjectId

  managerId  String?                 @map("manager_id") @db.ObjectId
  manager    OrganizationEmployees?  @relation("ManagerEmployees", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportees  OrganizationEmployees[] @relation("ManagerEmployees")
  branchId   String?                 @map("branch_id") @db.ObjectId
  branch     Branches?               @relation(fields: [branchId], references: [id])
  locationId String?                 @map("location_id") @db.ObjectId
  location   Locations?              @relation(fields: [locationId], references: [id])

  organization            Organizations              @relation(fields: [organizationId], references: [id])
  category                EmployeeCategories?        @relation(fields: [categoryId], references: [id])
  probationPolicy         ProbationPolicies?         @relation(fields: [probationPolicyId], references: [id])
  designation             OrganizationDesignations?  @relation("DesignationEmployees", fields: [designationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendance              Attendance[]
   departmentAssignments   EmployeeDepartments[]
   EmployeeShiftAssignment EmployeeShiftAssignment[]
  regularisations         AttendanceRegularisation[]
  leaveRequests           LeaveRequests[]
  workrequests            WorkdayRequests[]
  loginLogs               LoginLogs[]

  createdAt                   DateTime                              @default(now()) @map("created_at")
  updatedAt                   DateTime                              @updatedAt @map("updated_at")
  deletedAt                   DateTime?                             @map("deleted_at")
  organizationDepartments     OrganizationDepartments[]
  attendanceReports           AttendanceReports[]
  salaryStructures            SalaryStructure[]
  salaryRevisions             SalaryRevision[]
  payslips                    Payslip[]
  SharedWithEmployees         FolderSharedWithEmployees[]           @relation("employees")
  SharedByEmployees           FolderSharedWithEmployees[]           @relation("addedBy")
  folders                     Folders[]
