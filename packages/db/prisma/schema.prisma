model EmployeeDepartments {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  departmentId String                  @map("department_id") @db.ObjectId
  department   OrganizationDepartments @relation(fields: [departmentId], references: [id])
  employeeId   String                  @map("employee_id") @db.ObjectId
  employee     OrganizationEmployees   @relation(fields: [employeeId], references: [id])
  reportingTo  String?                 @map("reporting_to") @db.ObjectId
  reporting    OrganizationEmployees?  @relation("reporting_to_employee", fields: [reportingTo], references: [id])
  startDate    DateTime                @map("start_date")
  endDate      DateTime?               @map("end_date")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  deletedAt    DateTime?               @map("deleted_at")
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  HOLIDAY
}

enum LogType {
  CHECK_IN
  CHECK_OUT
  ADJUSTMENT
}

enum AttendanceMode {
  OFFICE
  WORK_FROM_HOME
  ON_DUTY
  PARTIAL_DAY
}

model Attendance {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String    @map("organization_id") @db.ObjectId
  employeeId         String    @map("employee_id") @db.ObjectId
  date               DateTime  @db.Date
  checkIn            DateTime? @map("check_in")
  checkOut           DateTime? @map("check_out")
  location           Json?
  grossHours         Float?    @map("gross_hours")
  effectiveHours     Float?    @map("effective_hours")
  lateArrivalMinutes Int?      @map("late_arrival_minutes")

  status    AttendanceStatus @default(PENDING)
  isHoliday Boolean          @default(false) @map("is_holiday")
  requests  Json?
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  mode      AttendanceMode?  @default(OFFICE)

  // Relations
  organization    Organizations              @relation(fields: [organizationId], references: [id])
  employee        OrganizationEmployees      @relation(fields: [employeeId], references: [id])
  logs            AttendanceLogs[]
  regularisations AttendanceRegularisation[]
  workrequests    WorkdayRequests[]
}

model AttendanceLogs {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  attendanceId String  @map("attendance_id") @db.ObjectId
  type         LogType @map("type")
  ipAddress    String?
  geoLocation  Json?

  source    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id])
}

model Shifts {
  id               String                    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String                    @db.ObjectId
  name             String
  startTime        DateTime
  endTime          DateTime
  breakMinutes     Int?
  applicableDays   Json?                     @map("applicable_days")
  weeklyOff        String[]
  organization     Organizations             @relation(fields: [organizationId], references: [id])
  shiftAssignments EmployeeShiftAssignment[]
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  deletedAt        DateTime?                 @map("deleted_at")
}

enum RegularisationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceRegularisation {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  attendanceId String                 @db.ObjectId
  employeeId   String                 @db.ObjectId
  reason       String
  status       RegularisationStatus   @default(PENDING)
  requestedAt  DateTime               @default(now())
  approvedAt   DateTime?
  approvedBy   String?                @map("approved_by") @db.ObjectId
  remarks      String?
  attendance   Attendance?            @relation(fields: [attendanceId], references: [id])
  employee     OrganizationEmployees? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  deletedAt    DateTime?              @map("deleted_at")
}

model ApprovalFlows {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @map("organization_id") @db.ObjectId
  entityType     String // LEAVE, REGULARISATION, etc.
  organization   Organizations @relation(fields: [organizationId], references: [id])

  levels            ApprovalFlowLevels[]
  approvalInstances ApprovalInstance[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model ApprovalLogs {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  approvalId     String     @map("approval_id") @db.ObjectId
  organizationId String     @map("organization_id") @db.ObjectId
  entityId       String     @map("entity_id") @db.ObjectId
  entityType     EntityType
  level          Int
  approverId     String?    @map("approver_id") @db.ObjectId
  action         String // APPROVED, REJECTED, AUTO_APPROVED etc
  remarks        String?
  approvedAt     DateTime   @default(now())

  approval     ApprovalInstance @relation(fields: [approvalId], references: [id])
  organization Organizations    @relation(fields: [organizationId], references: [id])
}

enum EntityType {
  LEAVE
  REGULARISATION
  WORKDAY
}

model ApprovalInstance {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String @map("organization_id") @db.ObjectId

  entityId   String     @map("entity_id") @db.ObjectId
  entityType EntityType // LEAVE / REGULARISATION / WORKDAY etc

  flowId       String @map("flow_id") @db.ObjectId
  currentLevel Int
  status       String // PENDING / IN_PROGRESS / COMPLETED / REJECTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs         ApprovalLogs[]
  flow         ApprovalFlows  @relation(fields: [flowId], references: [id])
  organization Organizations  @relation(fields: [organizationId], references: [id])
}

model ApprovalFlowLevels {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  flowId          String  @map("flow_id") @db.ObjectId
  level           Int
  autoApproveDays Int?    @default(3)
  escalationRole  String?
  isActive        Boolean @default(true)

  flow      ApprovalFlows           @relation(fields: [flowId], references: [id])
  approvers ApprovalFlowApprovers[]
}

model ApprovalFlowApprovers {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  levelId        String             @map("level_id") @db.ObjectId
  userId         String?            @map("user_id") @db.ObjectId // direct approver
  role           String? // MANAGER / HR / LEAD
  organizationId String?            @map("organization_id") @db.ObjectId
  organization   Organizations?     @relation(fields: [organizationId], references: [id])
  level          ApprovalFlowLevels @relation(fields: [levelId], references: [id])
}

model Holidays {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @db.ObjectId
  date           DateTime
  name           String
  region         String?
  organization   Organizations @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
}

model EmployeeShiftAssignment {
  id         String                @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String                @map("employee_id") @db.ObjectId
  shiftId    String                @map("shift_id") @db.ObjectId
  validFrom  DateTime
  validTo    DateTime?
  employee   OrganizationEmployees @relation(fields: [employeeId], references: [id])
  shift      Shifts                @relation(fields: [shiftId], references: [id])
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  deletedAt  DateTime?             @map("deleted_at")
}

model GeoFences {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String  @map("organization_id") @db.ObjectId
  name           String // e.g., "Head Office"
  latitude       Float // center lat
  longitude      Float // center lng
  radiusMeters   Int // allowed radius (meters)
  isActive       Boolean @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveTypes {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String  @db.ObjectId
  name           String // "Casual Leave"
  code           String // "CL"
  paid           Boolean @default(true)
  maxPerYear     Int?    @map("max_per_year")

  organization  Organizations   @relation(fields: [organizationId], references: [id])
  leaveRequests LeaveRequests[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model LeaveRequests {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  employeeId     String                @map("employee_id") @db.ObjectId
  organizationId String                @map("organization_id") @db.ObjectId
  leaveTypeId    String                @map("leave_type_id") @db.ObjectId
  startDate      DateTime              @map("start_date")
  endDate        DateTime              @map("end_date")
  reason         String?
  status         LeaveStatus           @default(PENDING)
  approvedAt     DateTime?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")
  organization   Organizations         @relation(fields: [organizationId], references: [id])
  employee       OrganizationEmployees @relation(fields: [employeeId], references: [id])
  leaveType      LeaveTypes            @relation(fields: [leaveTypeId], references: [id])
}

model AttendancePolicies {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String  @map("organization_id") @db.ObjectId
  name               String // "Default Attendance Policy"
  graceMinutes       Int?    @default(10) // Late grace period
  halfDayMinutes     Int?    @default(240) // 4 hours
  fullDayMinutes     Int?    @default(480) // 8 hours
  allowGeoCheckIn    Boolean @default(true)
  allowOutsideGeo    Boolean @default(false)
  autoMarkAbsent     Boolean @default(true)
  checkInBufferMin   Int?    @default(15)
  checkOutBufferMin  Int?    @default(15)
  roundingStrategy   String? // e.g. "nearest_15_min"
  overtimeAllowed    Boolean @default(false)
  minOvertimeMinutes Int?    @default(30)
  isActive           Boolean @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

model LeavePolicies {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId    String  @map("organization_id") @db.ObjectId
  name              String // "Default Leave Policy"
  carryForward      Boolean @default(true)
  maxCarryForward   Int?    @default(12)
  encashmentAllowed Boolean @default(false)
  sandwichRule      Boolean @default(true)
  accrualFrequency  String? @default("monthly") // daily / monthly / yearly
  accrueAfterDays   Int?    @default(30)
  isActive          Boolean @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

model ShiftPolicies {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String  @map("organization_id") @db.ObjectId
  name             String // "Rotational Shift Policy"
  autoAssign       Boolean @default(false)
  graceBeforeStart Int?    @default(10) // minutes early allowed
  graceAfterEnd    Int?    @default(10) // minutes late allowed
  nightShiftStart  String? // "22:00"
  nightShiftEnd    String? // "06:00"
  rotational       Boolean @default(false)
  rotationPeriod   Int?    @default(7)
  isActive         Boolean @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

model HolidayPolicies {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @map("organization_id") @db.ObjectId
  name           String // "India North Region Policy"
  region         String
  applicableTo   String[] // list of branch codes or dept IDs
  isActive       Boolean  @default(true)

  organization Organizations @relation(fields: [organizationId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
}

model NetworkPolicies {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @map("organization_id") @db.ObjectId
  name           String // e.g., "Office WiFi Only"
  enforceOn      String        @default("ATTENDANCE") // "LOGIN" | "ATTENDANCE" | "BOTH"
  allowedIPs     String[] // array of exact IPs (e.g., ["203.0.113.5", "203.0.113.6"])
  isActive       Boolean       @default(true)
  organization   Organizations @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
}

enum WorkdayType {
  WORK_FROM_HOME
  ON_DUTY
  PARTIAL_DAY
}

enum WorkdayStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model WorkdayRequests {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                @map("organization_id") @db.ObjectId
  employeeId     String                @map("employee_id") @db.ObjectId
  type           WorkdayType
  startDate      DateTime              @map("start_date")
  endDate        DateTime?             @map("end_date")
  startTime      DateTime?             @map("start_time")
  endTime        DateTime?             @map("end_time")
  reason         String?
  status         WorkdayStatus         @default(PENDING)
  approvalLevel  Int?                  @default(1)
  approvedAt     DateTime?
  approvedBy     String?               @map("approved_by") @db.ObjectId
  remarks        String?
  attendanceId   String?               @map("attendance_id") @db.ObjectId
  organization   Organizations         @relation(fields: [organizationId], references: [id])
  employee       OrganizationEmployees @relation(fields: [employeeId], references: [id])
  attendance     Attendance?           @relation(fields: [attendanceId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model AssetCategories {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @map("organization_id") @db.ObjectId
  name           String
  code           String
  description    String
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  organization   Organizations @relation(fields: [organizationId], references: [id])
  assetModels    AssetModels[]
}

model AssetModels {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String          @map("organization_id") @db.ObjectId
  categoriesId    String          @map("category_id") @db.ObjectId
  brand           String
  modelName       String
  code            String
  description     String
  specs           Json?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  assets          Assets[]
  assetCategories AssetCategories @relation(fields: [categoriesId], references: [id])
  organization    Organizations   @relation(fields: [organizationId], references: [id])
}

model Assets {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String             @map("organization_id") @db.ObjectId
  categoriesId    String             @map("category_id") @db.ObjectId
  modelId         String             @map("model_id") @db.ObjectId
  serialNumber    String
  assetTag        String
  userName        String?
  password        String?
  purchaseDate    DateTime
  warrantyExpire  DateTime
  status          String             @default("Available")
  location        Json?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @default(now()) @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  assetAssignment AssetAssignments[]
  assetcondition  AssetCondition[]
  assetModel      AssetModels        @relation(fields: [modelId], references: [id])
  organization    Organizations      @relation(fields: [organizationId], references: [id])
}

model AssetRequest {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String                 @map("organization_id") @db.ObjectId
  categoriesId    String                 @map("category_id") @db.ObjectId
  modelId         String                 @map("model_id") @db.ObjectId
  employeeId      String                 @map("employee_id") @db.ObjectId
  approvedById    String?                @map("approved_by") @db.ObjectId
  reason          String
  quantity        Int                    @default(1)
  priority        String                 @default("Medium")
  status          String                 @default("Pending")
  approvedAt      DateTime?              @map("approved_at")
  rejectionReason String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @default(now()) @map("updated_at")
  deletedAt       DateTime?              @map("deleted_at")
  employee        OrganizationEmployees  @relation("RequestedBy", fields: [employeeId], references: [id])
  approvedBy      OrganizationEmployees? @relation("ApprovedBy", fields: [approvedById], references: [id])
}

model AssetAssignments {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String                @map("organization_id") @db.ObjectId
  assetId         String                @map("asset_id ") @db.ObjectId
  employeeId      String                @map("employee_id") @db.ObjectId
  assignedDate    DateTime              @map("assigned_date")
  returnDate      DateTime?             @map("return_date")
  conditionAssign Json?
  status          String                @default("Active")
  notes           String
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @default(now()) @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")
  assetcondition  AssetCondition[]
  asset           Assets                @relation(fields: [assetId], references: [id])
  organization    Organizations         @relation(fields: [organizationId], references: [id])
  employee        OrganizationEmployees @relation(fields: [employeeId], references: [id])
}

model AssetCondition {
  id               String                 @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String                 @map("organization_id") @db.ObjectId
  assignmentId     String                 @map("assignment_id") @db.ObjectId
  employeeId       String                 @map("employee_id") @db.ObjectId
  acknowledgedById String?                @map("acknowledged_by") @db.ObjectId
  reportDate       DateTime               @map("report_date")
  description      String
  ratings          String?                @default("Good")
  images           Json?
  actionTaken      String
  acknowledgedBy   OrganizationEmployees? @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  assignment       AssetAssignments       @relation(fields: [assignmentId], references: [id])
  organization     Organizations          @relation(fields: [organizationId], references: [id])
  employee         OrganizationEmployees  @relation(fields: [employeeId], references: [id])
  acknowledgedDate DateTime?
  status           String                 @default("Reported")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @default(now()) @map("updated_at")
  deletedAt        DateTime?              @map("deleted_at")
  assets           Assets?                @relation(fields: [assetsId], references: [id])
  assetsId         String?                @db.ObjectId
}

model PollPosts {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String @map("organization_id") @db.ObjectId
  employeeId     String @map("employee_id") @db.ObjectId

  title       String?
  description String
  image       String?
  tags        String[] @default([])

  isVotingPoll Boolean @default(false) @map("is_voting_poll")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now())@updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  employee     OrganizationEmployees @relation(fields: [employeeId], references: [id])
  organization Organizations         @relation(fields: [organizationId], references: [id])

  options  PollOptions[]
  votes    PollVotes[]
  likes    PollLikes[]
  comments PollComments[]
  saves    PollSaves[]
  shares   PollShares[]
}

model PollLikes {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  postId     String   @map("post_id") @db.ObjectId
  employeeId String   @map("employee_id") @db.ObjectId
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  poll     PollPosts             @relation(fields: [postId], references: [id])
  employee OrganizationEmployees @relation(fields: [employeeId], references: [id])
}

model PollComments {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  postId     String    @map("post_id") @db.ObjectId
  employeeId String    @map("employee_id") @db.ObjectId
  comment    String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  poll     PollPosts             @relation(fields: [postId], references: [id])
  employee OrganizationEmployees @relation(fields: [employeeId], references: [id])
}

model PollSaves {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  postId     String   @map("post_id") @db.ObjectId
  employeeId String   @map("employee_id") @db.ObjectId
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  poll     PollPosts             @relation(fields: [postId], references: [id])
  employee OrganizationEmployees @relation(fields: [employeeId], references: [id])
}

model PollShares {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  postId     String   @map("post_id") @db.ObjectId
  employeeId String   @map("employee_id") @db.ObjectId
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  poll     PollPosts             @relation(fields: [postId], references: [id])
  employee OrganizationEmployees @relation(fields: [employeeId], references: [id])
}

model PollOptions {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  postId     String    @map("post_id") @db.ObjectId
  label      String // e.g. "React" or "Goa"
  votesCount Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  poll  PollPosts   @relation(fields: [postId], references: [id])
  votes PollVotes[]
}

model PollVotes {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  postId     String   @map("post_id") @db.ObjectId
  optionId   String   @map("option_id") @db.ObjectId
  employeeId String   @map("employee_id") @db.ObjectId
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  poll     PollPosts             @relation(fields: [postId], references: [id])
  option   PollOptions           @relation(fields: [optionId], references: [id])
  employee OrganizationEmployees @relation(fields: [employeeId], references: [id])
}
