{
  "name": "jury-hrms-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start:org": "bun services/organization-service/server.js",
    "start:emp-cat": "bun services/employee-category-service/server.js",
    "start:emp": "bun services/employee-service/server.js",
    "start:admin": "bun services/admin-service/server.js",
    "start:org-dep": "bun services/org_department-service/server.js",
    "start:org-desg": "bun services/org_designation-service/server.js",
    "start:emp-dept": "bun services/emp-department-service/server.js",
    "start:emp-onboard-flow": "bun services/emp-onboarding-flow-service/server.js",
    "start:emp-onboard-step": "bun services/emp-onboarding-step-service/server.js",
    "start:emp-onboard-feature": "bun services/emp-onboarding-feature-service/server.js",
    "start:emp-onboard-progress": "bun services/emp-onboarding-progress-service/server.js",
    "start:gateway": "bun apps/api-gateway/server.js",
    "start:attendance-service": "bun services/attendance-service/server.js",
    "start:attendance-logs-service": "bun services/atttendace-logs-service/server.js",
    "start:attendance-regularisation-service": "bun services/attendance-regularisation-service/server.js",
    "start:shift-service": "bun services/shift-service/server.js",
    "start:shift-assignment-service": "bun services/shift-assignment-service/server.js",
    "start:shift-policy-service": "bun services/shift-policy-service/server.js",
    "start:holiday-service": "bun services/holiday-service/server.js",
    "start": "bunx concurrently -n \"ORG,EMP-CAT,EMP,ADMIN,ORG-DEP,ORG-DESG,EMP-DEPT,ONBOARD-FLOW,ONBOARD-STEP,ONBOARD-FEATURE,ONBOARD-PROGRESS,GATEWAY,ATTENDANCE,ATT-REG,SHIFT,SHIFT-ASSIGN,HOLIDAY,SHIFT-POLICY,ATT-LOGS\" -c \"magenta,cyan,green,yellow,blue,red,white,gray,magentaBright,cyanBright,greenBright,yellowBright,blueBright,redBright,whiteBright,grayBright,magenta\" \"bun run start:org\" \"bun run start:emp-cat\" \"bun run start:emp\" \"bun run start:admin\" \"bun run start:org-dep\" \"bun run start:org-desg\" \"bun run start:emp-dept\" \"bun run start:emp-onboard-flow\" \"bun run start:emp-onboard-step\" \"bun run start:emp-onboard-feature\" \"bun run start:emp-onboard-progress\" \"bun run start:gateway\" \"bun run start:attendance-service\" \"bun run start:attendance-regularisation-service\" \"bun run start:shift-service\" \"bun run start:shift-assignment-service\" \"bun run start:holiday-service\" \"bun run start:shift-policy-service\" \"bun run start:attendance-logs-service\"",
    "prisma:generate": "bunx prisma generate --schema=packages/db/prisma/schema.prisma",
    "prisma:push": "bunx prisma db push --schema=packages/db/prisma/schema.prisma",
    "prisma:studio": "bunx prisma studio --schema=packages/db/prisma/schema.prisma",
    "format": "bunx prettier --write .",
    "lint": "bunx eslint ."
  },

  "devDependencies": {
    "prettier": "latest",
    "eslint": "latest"
  },

  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.4",
    "date-fns": "^4.1.0",
    "hono": "^4.10.4",
    "hono-rate-limit": "^1.0.2",
    "jose": "^6.1.0",
    "nodemailer": "^7.0.10",
    "p-queue": "^9.0.0",
    "redlock": "^5.0.0-beta.2",
    "swagger-ui-dist": "^5.30.1",
    "zod": "^4.1.12"
  }
}